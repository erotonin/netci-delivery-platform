# Copy to .env and change every credential before using this on a shared machine.
JENKINS_ADMIN_PASSWORD=change-me-local-only
POSTGRES_PASSWORD=netci-local-only
MINIO_ROOT_USER=netci
MINIO_ROOT_PASSWORD=netci-local-only

# Pinned images: a rebuild tomorrow must produce the same stack as today.
POSTGRES_IMAGE=postgres:16.15-alpine3.24
REGISTRY_IMAGE=registry:3.1.1
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
TEMPORAL_IMAGE=temporalio/temporal:1.8.2

# Host ports. Override any that are already taken on your machine -- the gates read
# the same values, so moving a port here moves it everywhere.
POSTGRES_HOST_PORT=5432
REGISTRY_HOST_PORT=5000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
NETCI_API_HOST_PORT=8000
JENKINS_A_HOST_PORT=8081
JENKINS_B_HOST_PORT=8082
JENKINS_A_AGENT_HOST_PORT=50001
JENKINS_B_AGENT_HOST_PORT=50002

REGISTRY_URL=http://localhost:5000
MINIO_ENDPOINT=localhost:9000
TEMPORAL_ADDRESS=localhost:7233
NETCI_ENVIRONMENT=local
NETCI_PIPELINE_API_KEY=netci-local-pipeline-key
NETCI_ALLOWED_ORIGINS=http://localhost:5173

# Which engines netCI drives. "none" records state and waits for authenticated
# callbacks; it never pretends work ran. Switch to jenkins/temporal once those
# engines are reachable, and see docs/api-contract.md for the credentials each needs.
NETCI_CI_MODE=none
NETCI_CD_MODE=none

# Fail-closed supply chain: when true, an artifact with no published SBOM/scan/signature
# evidence cannot be deployed at all. The Ubuntu acceptance profile turns this on.
NETCI_REQUIRE_SECURITY_EVIDENCE=false

# Only needed when NETCI_CI_MODE=jenkins. *_FILE variants are read from a mounted
# secret file instead, which keeps the token out of the process environment.
NETCI_JENKINS_CONTROLLERS=A,B
JENKINS_A_URL=http://localhost:8081
JENKINS_A_USERNAME=admin
JENKINS_A_API_TOKEN=change-me-local-only
JENKINS_B_URL=http://localhost:8082
JENKINS_B_USERNAME=admin
JENKINS_B_API_TOKEN=change-me-local-only
NETCI_CALLBACK_URL=http://host.docker.internal:8000

KUBERNETES_API_URL=https://host.docker.internal:6443
KUBERNETES_CREDENTIALS_ID=netci-kind-kubeconfig
JENKINS_A_AGENT_URL=http://host.docker.internal:8081
JENKINS_A_AGENT_TUNNEL=host.docker.internal:50001
JENKINS_B_AGENT_URL=http://host.docker.internal:8082
JENKINS_B_AGENT_TUNNEL=host.docker.internal:50002
