# Copy to .env and change every credential before using this on a shared machine.
JENKINS_ADMIN_PASSWORD=change-me-local-only
POSTGRES_PASSWORD=netci-local-only
MINIO_ROOT_USER=netci
MINIO_ROOT_PASSWORD=netci-local-only

# Pinned images: a rebuild tomorrow must produce the same stack as today.
POSTGRES_IMAGE=postgres:16.15-alpine3.24
REGISTRY_IMAGE=registry:3.1.1
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
TEMPORAL_IMAGE=temporalio/temporal:1.8.2

# Host ports. Override any that are already taken on your machine -- the gates read
# the same values, so moving a port here moves it everywhere.
POSTGRES_HOST_PORT=5432
REGISTRY_HOST_PORT=5000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
NETCI_API_HOST_PORT=8000
JENKINS_A_HOST_PORT=8081
JENKINS_B_HOST_PORT=8082
JENKINS_A_AGENT_HOST_PORT=50001
JENKINS_B_AGENT_HOST_PORT=50002

REGISTRY_URL=http://localhost:5000
MINIO_ENDPOINT=localhost:9000
TEMPORAL_ADDRESS=localhost:7233
NETCI_ENVIRONMENT=local
NETCI_PIPELINE_API_KEY=netci-local-pipeline-key
NETCI_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- who may do what
#
# none   every caller is anonymous and holds every role. netCI then serves loopback
#        only, so forgetting this setting cannot publish production approval to the
#        network. Local development only.
# token  bearer tokens listed in NETCI_AUTH_TOKENS_FILE as SHA-256 hashes. Issue and
#        revoke them with `python scripts/netci_token.py`.
# oidc   bearer JWTs from the corporate identity provider, verified against its JWKS.
#        Preferred for a real deployment: joiners and leavers follow the directory,
#        and netCI never holds a credential of its own.
NETCI_AUTH_MODE=none
# NETCI_AUTH_TOKENS_FILE=/etc/netci/tokens.yaml

# Only for NETCI_AUTH_MODE=oidc. The role map is what turns IdP groups into netCI
# permissions; a token whose groups map to nothing is refused rather than let in with
# no rights. NETCI_OIDC_JWKS_URL defaults to <issuer>/.well-known/jwks.json.
# NETCI_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# NETCI_OIDC_AUDIENCE=api://netci
# NETCI_OIDC_JWKS_URL=
# NETCI_OIDC_ROLES_CLAIM=roles
# NETCI_OIDC_ROLE_MAP=netci-admins=platform-admin,release-managers=reviewer,engineers=developer

# Which applications a caller may act on, on top of what their role permits. An
# application carries an ownerTeam; a principal carries the teams it belongs to. Leave
# false while ownership is being adopted -- an application with no owner then behaves as
# it always has. Set true once every application has an owner: an unowned one becomes
# platform-admin only, and new ones must name a team.
NETCI_REQUIRE_APPLICATION_OWNER=false
# For oidc, the claim carrying group membership (default: groups).
# NETCI_OIDC_TEAMS_CLAIM=groups

# The requester of a production release may not also approve it. Turn this off only for
# a single-operator lab; with NETCI_AUTH_MODE=none it is inactive anyway, because there
# is only ever one identity to compare.
NETCI_REQUIRE_SEPARATION_OF_DUTIES=true

# Which engines netCI drives. "none" records state and waits for authenticated
# callbacks; it never pretends work ran. Switch to jenkins/temporal once those
# engines are reachable, and see docs/api-contract.md for the credentials each needs.
NETCI_CI_MODE=none
NETCI_CD_MODE=none

# Fail-closed supply chain: when true, an artifact with no published SBOM/scan/signature
# evidence cannot be deployed at all. The Ubuntu acceptance profile turns this on.
NETCI_REQUIRE_SECURITY_EVIDENCE=false

# Re-verify the artifact signature at deploy time, instead of trusting the "verified"
# boolean CI wrote about its own work. `cosign` fails closed: an artifact that cannot be
# verified is not deployed. Needs cosign on the worker host and the *public* key -- netCI
# never needs the signing key, and holding one would let the deployment host mint the
# signatures it is supposed to be checking.
NETCI_SIGNATURE_VERIFY_MODE=none
# NETCI_COSIGN_PUBLIC_KEY_FILE=/etc/netci/cosign.pub
# NETCI_SIGNATURE_VERIFY_TIMEOUT=60
#
# Must match how the artifact was signed. The checked-in CI scripts sign with
# --tlog-upload=false, so verification ignores the transparency log by default; cosign
# otherwise fails with "signature not found in transparency log", which looks like a bad
# signature but is a configuration mismatch. With a real Rekor, set this true -- a
# signature that was never logged is then correctly refused.
# NETCI_SIGNATURE_REQUIRE_TLOG=false

# Time-boxed exceptions to the vulnerability gate: one CVE, one digest, one expiry date,
# a named owner and a named approver. Unset means no exception is possible, which is the
# right default. Keep the file in Git -- the review on the entry is the control.
# NETCI_SECURITY_EXCEPTIONS_FILE=/etc/netci/security-exceptions.yaml

# Only needed when NETCI_CI_MODE=jenkins. *_FILE variants are read from a mounted
# secret file instead, which keeps the token out of the process environment.
NETCI_JENKINS_CONTROLLERS=A,B
JENKINS_A_URL=http://localhost:8081
JENKINS_A_USERNAME=admin
JENKINS_A_API_TOKEN=change-me-local-only
JENKINS_B_URL=http://localhost:8082
JENKINS_B_USERNAME=admin
JENKINS_B_API_TOKEN=change-me-local-only
NETCI_CALLBACK_URL=http://host.docker.internal:8000

KUBERNETES_API_URL=https://host.docker.internal:6443
KUBERNETES_CREDENTIALS_ID=netci-kind-kubeconfig
JENKINS_A_AGENT_URL=http://host.docker.internal:8081
JENKINS_A_AGENT_TUNNEL=host.docker.internal:50001
JENKINS_B_AGENT_URL=http://host.docker.internal:8082
JENKINS_B_AGENT_TUNNEL=host.docker.internal:50002
