{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netci.local/schemas/benchmark-report.json",
  "type": "object",
  "required": ["applicationId", "baseline", "ephemeral", "comparison", "environment"],
  "properties": {
    "applicationId": {"type": "string"},
    "environment": {"type": "string", "description": "Host/runtime identity; do not compare different environments without qualification."},
    "baseline": {"$ref": "#/$defs/mode"},
    "ephemeral": {"$ref": "#/$defs/mode"},
    "comparison": {
      "type": "object",
      "required": ["totalDeltaPercent", "buildDeltaPercent", "cacheHitRate", "conclusion"],
      "properties": {
        "totalDeltaPercent": {"type": "number"},
        "buildDeltaPercent": {"type": "number"},
        "cacheHitRate": {"type": "number", "minimum": 0, "maximum": 1},
        "conclusion": {"enum": ["acceptable", "regression", "inconclusive"]}
      }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "required": ["runs", "successRate", "totalSecondsAvg", "queueSecondsAvg", "provisioningSecondsAvg", "cacheRestoreSecondsAvg", "buildSecondsAvg", "cleanupSecondsAvg"],
      "properties": {
        "runs": {"type": "integer", "minimum": 1},
        "successRate": {"type": "number", "minimum": 0, "maximum": 1},
        "totalSecondsAvg": {"type": "number", "minimum": 0},
        "queueSecondsAvg": {"type": "number", "minimum": 0},
        "provisioningSecondsAvg": {"type": "number", "minimum": 0},
        "cacheRestoreSecondsAvg": {"type": "number", "minimum": 0},
        "buildSecondsAvg": {"type": "number", "minimum": 0},
        "cleanupSecondsAvg": {"type": "number", "minimum": 0}
      }
    }
  }
}
