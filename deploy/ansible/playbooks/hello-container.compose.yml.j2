services:
  hello-container:
    image: "{{ netci_image_repository }}@{{ netci_artifact_digest }}"
    container_name: "{{ netci_app_name }}"
    restart: unless-stopped
{% if netci_network_mode == 'host' %}
    # Host networking is used where the Docker daemon has no bridge/NAT available
    # (see docs/troubleshooting.md); the app binds the port directly.
    network_mode: host
{% else %}
    ports:
      - "{{ netci_host_port }}:{{ netci_container_port }}"
{% endif %}
    environment:
      APP_VERSION: "{{ netci_artifact_digest }}"
      APP_PORT: "{{ netci_container_port }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
