services:
  hello-container:
    image: "{{ image_repository }}@{{ artifact_digest }}"
    container_name: "{{ app_name }}"
    restart: unless-stopped
    ports:
      - "{{ host_port }}:8080"
    environment:
      APP_VERSION: "{{ artifact_digest }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
