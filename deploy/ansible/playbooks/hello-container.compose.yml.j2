services:
  hello-container:
    image: "{{ netci_image_repository }}@{{ netci_artifact_digest }}"
    container_name: "{{ netci_app_name }}"
    restart: unless-stopped
    ports:
      - "{{ netci_host_port }}:8080"
    environment:
      APP_VERSION: "{{ netci_artifact_digest }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
