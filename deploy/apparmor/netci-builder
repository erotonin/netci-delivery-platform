# AppArmor profile for the build container of netCI's build pods (ADR-091).
#
# Rootless Buildah builds an image by unpacking each layer inside a user namespace it creates,
# which needs `userns` and `mount`. On Ubuntu 24.04 neither is open to a container: the runtime's
# default profile (cri-containerd.apparmor.d) denies mount, and kernel.apparmor_restrict_unprivileged_userns=1
# confines an unprivileged user namespace to a profile without capabilities -- the first build on
# the HA lab failed so ("remount /: permission denied"). Rather than switch that kernel guard off
# for every process on the node, the build container alone runs under this profile.
#
# What it grants is bounded by the kernel: capabilities and mounts inside a user namespace act on
# that namespace's own resources. The container still runs as uid 1000 with no capabilities in the
# node's namespace; writes to the kernel's tunables and to sysfs are denied as in the default profile.
#
# Install it on every build node, where boot loads it again -- loaded only with apparmor_parser it was
# gone after the HA lab's power cut, and every build pod there failed "apparmor profile not found":
#   sudo install -m 644 deploy/apparmor/netci-builder /etc/apparmor.d/netci-builder
#   sudo apparmor_parser -r -W /etc/apparmor.d/netci-builder
# Use it from a pod:             securityContext.appArmorProfile: {type: Localhost, localhostProfile: netci-builder}

abi <abi/4.0>,
include <tunables/global>

profile netci-builder flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  userns,
  capability,
  mount,
  umount,
  pivot_root,
  network,
  file,
  signal,
  unix,
  ptrace (read, readby),

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
