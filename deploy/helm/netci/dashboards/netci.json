{
 "title": "netCI",
 "uid": "netci-overview",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   }
  ]
 },
 "tags": [
  "netci"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Takeover (Cell Supervisor)",
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "stat",
   "title": "Replica leading",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "expr": "max(netci_supervisor_leading)",
     "legendFormat": "leading",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "1 when a replica acts; 0 means no takeover can happen."
  },
  {
   "type": "stat",
   "title": "Cells observed",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "expr": "max(netci_supervisor_cells)",
     "legendFormat": "cells",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Cells lost, not taken over",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "expr": "max(netci_supervisor_cells_lost)",
     "legendFormat": "lost",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Cells sharing a machine",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "expr": "max(netci_supervisor_cells_sharing_a_machine)",
     "legendFormat": "sharing",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Cells one machine's loss would take together."
  },
  {
   "type": "stat",
   "title": "Cells without headroom",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "count(min by (cell) (netci_supervisor_cell_headroom) == 0) or vector(0)",
     "legendFormat": "no headroom",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Cells no other machine could take if theirs were lost (a necessary condition)."
  },
  {
   "type": "timeseries",
   "title": "Takeover: last renewal to Lease held again",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(netci_supervisor_takeover_seconds_bucket[6h])) by (le))",
     "legendFormat": "p50",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(netci_supervisor_takeover_seconds_bucket[6h])) by (le))",
     "legendFormat": "p95",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Fencing: decision to pod deleted",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(netci_supervisor_fence_seconds_bucket[6h])) by (le))",
     "legendFormat": "p95",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Actions",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (kind, result) (increase(netci_supervisor_actions_total[5m]))",
     "legendFormat": "{{kind}} {{result}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum(increase(netci_supervisor_alerts_total[5m]))",
     "legendFormat": "needs a person",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Observations failed / restarted",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum(rate(netci_supervisor_observe_errors_total[5m]))",
     "legendFormat": "failed /s",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum(rate(netci_supervisor_observation_resets_total[5m]))",
     "legendFormat": "restarted /s",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum(increase(netci_supervisor_lease_moved_total[1h]))",
     "legendFormat": "fencing stopped: wrong mapping",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "Cells",
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Lease held",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "max by (namespace) (netci_cell_lease_held)",
     "legendFormat": "{{namespace}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Lease lost (controller killed)",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 23,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (namespace) (increase(netci_cell_lease_lost_total[1h]))",
     "legendFormat": "{{namespace}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "JCasC applied in place",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 23,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (namespace, result) (increase(netci_cell_casc_reloads_total[1h]))",
     "legendFormat": "{{namespace}} {{result}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "Run queue",
   "id": 15,
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Runs accepted",
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (cell) (rate(netci_runs_accepted_total[5m]))",
     "legendFormat": "{{cell}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Accepted to started, p95",
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 31,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(netci_runs_accept_to_start_seconds_bucket[30m])) by (le, cell))",
     "legendFormat": "{{cell}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Controller errors / runs dispatched again",
   "id": 18,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 31,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (cell) (increase(netci_runs_controller_errors_total[10m]))",
     "legendFormat": "errors {{cell}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum by (cell) (increase(netci_runs_redispatched_total[1h]))",
     "legendFormat": "redispatched {{cell}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "Agent fabric",
   "id": 19,
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Sandboxes",
   "id": 20,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (pool, state) (netci_fabric_sandboxes)",
     "legendFormat": "{{pool}} {{state}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Claim to bind, p95",
   "id": 21,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(netci_fabric_claim_to_bind_seconds_bucket[30m])) by (le, pool))",
     "legendFormat": "{{pool}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Sandboxes failed",
   "id": 22,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (pool) (increase(netci_fabric_transitions_total{to=\"failed\"}[30m]))",
     "legendFormat": "{{pool}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}