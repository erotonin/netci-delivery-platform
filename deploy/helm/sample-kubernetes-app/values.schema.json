{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "service", "resources", "environment"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "not": {"pattern": "@|:latest$"}},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "controllerNamespace": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"}
      }
    },
    "netci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "releaseName": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
        "applicationId": {"type": "string", "pattern": "^$|^[0-9a-f-]{36}$"}
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "weight": {"type": "integer", "minimum": 0, "maximum": 100},
        "header": {"type": "string", "pattern": "^$|^[A-Za-z0-9-]+$"},
        "headerValue": {"type": "string", "pattern": "^[^\\r\\n\"]*$"},
        "cookie": {"type": "string", "pattern": "^$|^[A-Za-z0-9_-]+$"}
      }
    },
    "traits": {
      "type": "object",
      "properties": {
        "autoTlsIngress": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "host": {"type": "string"},
            "clusterIssuer": {"type": "string"},
            "tlsSecretName": {"type": "string"}
          }
        },
        "kedaAutoscaling": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer"},
            "maxReplicas": {"type": "integer"},
            "cooldownPeriod": {"type": "integer"},
            "pollingInterval": {"type": "integer"},
            "triggers": {"type": "array"}
          }
        },
        "zeroTrustGuard": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "resources": {"type": "object"},
    "environment": {"enum": ["dev", "staging", "prod"]},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"}
  }
}
