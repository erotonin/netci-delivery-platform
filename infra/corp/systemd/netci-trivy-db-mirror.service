# Refresh the lab Harbor's Trivy DB mirror (scripts/corp/mirror_trivy_db.sh, ADR-056).
# Installed as a *user* unit by scripts/corp/up.sh: no root, and nothing runs when the lab is
# not this user's.
[Unit]
Description=netCI corp lab: mirror the Trivy DB into Harbor
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/netci-delivery-platform
ExecStart=%h/netci-delivery-platform/scripts/corp/mirror_trivy_db.sh
