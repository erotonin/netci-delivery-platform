# Every 6 hours, and at the next boot if a run was missed (Persistent): the toolchain gate
# refuses scans with a DB older than trivyDb.maxAgeHours (72 h), so four chances a day.
[Unit]
Description=netCI corp lab: refresh the Trivy DB mirror every 6 hours

[Timer]
OnCalendar=*-*-* 00/6:17:00
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
