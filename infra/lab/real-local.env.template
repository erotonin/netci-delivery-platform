# netCI "real local" profile: production mode, every integration real, nothing simulated.
NETCI_ENVIRONMENT=production
DATABASE_URL=postgresql://netci:netci-local-only@127.0.0.1:55432/netci_live
NETCI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# people: Keycloak (real OIDC, JWKS-verified)
NETCI_AUTH_MODE=oidc
NETCI_OIDC_ISSUER=http://127.0.0.1:8180/realms/netci
NETCI_OIDC_AUDIENCE=netci
NETCI_OIDC_JWKS_URL=http://127.0.0.1:8180/realms/netci/protocol/openid-connect/certs
NETCI_OIDC_ROLES_CLAIM=groups
NETCI_OIDC_TEAMS_CLAIM=groups
NETCI_OIDC_ROLE_MAP=netci-admins=platform-admin,release-managers=reviewer,engineers=developer
NETCI_REQUIRE_SEPARATION_OF_DUTIES=true
# machines: per-run / per-deployment tokens; no shared key
NETCI_WORKLOAD_TOKEN_KEYS_FILE=__ROOT__/.netci-gate/keys/workload-token-keys
# CI: Jenkins A/B (JCasC, ephemeral agents on kind)
NETCI_CI_MODE=jenkins
NETCI_JENKINS_CONTROLLERS=A,B
JENKINS_A_URL=http://172.17.0.50:8080
JENKINS_A_USERNAME=admin
JENKINS_A_API_TOKEN=__JENKINS_ADMIN_PASSWORD__
JENKINS_B_URL=http://172.17.0.51:8080
JENKINS_B_USERNAME=admin
JENKINS_B_API_TOKEN=__JENKINS_ADMIN_PASSWORD__
NETCI_CALLBACK_URL=http://172.17.0.1:8100
NETCI_REGISTRY_PUSH_HOST=172.17.0.1:55000
NETCI_REGISTRY_PULL_HOST=172.17.0.1:55000
NETCI_BUILD_BASE_IMAGE=172.17.0.1:55000/netci/python-base:3.12-alpine
NETCI_TRIVY_DB_REPOSITORY=172.17.0.1:55000/aquasec/trivy-db:2
NETCI_GIT_URL=http://172.17.0.52/netci.git
NETCI_SAMPLE_APPS_REPOSITORY_BASE=http://172.17.0.52
# CD: Temporal (durable workflows)
NETCI_CD_MODE=temporal
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=netci-delivery
# supply chain: evidence required, signatures re-verified with the lab key
NETCI_REQUIRE_SECURITY_EVIDENCE=true
NETCI_SIGNATURE_VERIFY_MODE=cosign
NETCI_COSIGN_PUBLIC_KEY_FILE=__ROOT__/.netci-gate/keys/cosign.pub
NETCI_SIGNATURE_REQUIRE_TLOG=false
# inventory: NetBox
NETCI_DCIM_PROVIDER=netbox
NETCI_DCIM_BASE_URL=http://127.0.0.1:8080/api
NETCI_DCIM_API_TOKEN_FILE=__ROOT__/.netci-gate/keys/netbox-token
NETCI_REQUIRE_DCIM_REVALIDATION=true
NETCI_BUILD_COMMIT=2f18952dcbb54e11786b990ff2bfb5263c1e3ea6
NETCI_BUILD_BRANCH=main
# Same cosign as jenkins/agent-toolbox (3.1.2): a v2 verifier cannot read v3 bundle signatures
NETCI_COSIGN_EXECUTABLE=__ROOT__/.netci-gate/bin/cosign
NETCI_KUBECONFIG_DIR=__ROOT__/.netci-gate/kube
NETCI_ANSIBLE_COLLECTIONS_PATH=__ROOT__/.netci-gate/collections
NETCI_REGISTRY_ALLOW_HTTP=true
NETCI_ARTIFACT_CACHE_DIR=/var/tmp/netci-live/artifacts
NETCI_BUILD_ISOLATION=kubernetes
NETCI_BUILD_CLUSTER_KUBECONFIG=__ROOT__/.netci-gate/kube/netci-dev-kubeconfig
NETCI_BUILD_CONTROLLER_SERVICE_ACCOUNT=netci-build/jenkins-controller
NETCI_ACCEPTANCE_OIDC_TOKEN_URL=http://127.0.0.1:8180/realms/netci/protocol/openid-connect/token
NETCI_ACCEPTANCE_OIDC_CLIENT_ID=netci
NETCI_ACCEPTANCE_OIDC_CLIENT_SECRET=__OIDC_CLIENT_SECRET__
NETCI_ACCEPTANCE_USER_ADMIN=pat:netci-lab-only
NETCI_ACCEPTANCE_USER_REVIEWER=rae:netci-lab-only
NETCI_ACCEPTANCE_USER_DEVELOPER=dana:netci-lab-only
NETCI_LAB_USER_PASSWORD=__LAB_USER_PASSWORD__
NETCI_ANSIBLE_SECRET_DIR=__ROOT__/.netci-gate/ansible
NETCI_ANSIBLE_PRIVATE_KEY_FILE=__ROOT__/.netci-gate/ansible/ssh/id_ed25519
NETCI_ANSIBLE_KNOWN_HOSTS_FILE=__ROOT__/.netci-gate/ansible/ssh/known_hosts
NETCI_TRAFFIC_ROUTER=nginx-ingress
NETCI_TRAFFIC_KUBECONFIG=__ROOT__/.netci-gate/kube/netci-dev-kubeconfig
NETCI_BACKUP_ENCRYPTION_KEY=__BACKUP_ENCRYPTION_KEY__
