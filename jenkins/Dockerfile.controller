ARG JENKINS_CONTROLLER_IMAGE=jenkins/jenkins:2.555.3-lts-jdk21@sha256:e82bbdcffb6361c081ac66bbdcd5802a299b3631c78c3be04a0a91c7f952fff3
FROM ${JENKINS_CONTROLLER_IMAGE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git jq \
    && rm -rf /var/lib/apt/lists/*
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
# The image carries exactly the declared set (ADR-059) or is not built: a dependency the
# resolver pulled in or upgraded would otherwise surface only as drift after the rollout.
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt --no-download --list 2>/dev/null \
      | sed -n '/^Installed plugins:/,/^$/p' | sed '1d;/^$/d' | tr ' ' ':' | sort > /tmp/installed \
    && grep -v '^#' /usr/share/jenkins/ref/plugins.txt | sort > /tmp/declared \
    && diff -u /tmp/declared /tmp/installed \
    && rm /tmp/installed /tmp/declared

# The Jenkins library retriever requires a real SCM repository. Snapshot the
# checked-in library into the controller image so JCasC can fetch branch main
# without any UI setup or mutable controller-home state.
COPY --chown=jenkins:jenkins shared-library/ /opt/netci-shared-library/
# The snapshot is created as the jenkins user that owns the files. Running git as
# root over a jenkins-owned tree trips git's dubious-ownership guard, and marking the
# path safe for root would hide that guard rather than satisfy it.
RUN su jenkins -s /bin/sh -c '\
      git -C /opt/netci-shared-library init --initial-branch=main \
      && git -C /opt/netci-shared-library add . \
      && git -C /opt/netci-shared-library \
         -c user.name="netCI build" -c user.email="netci@localhost" \
         commit -m "Snapshot netCI shared library"'
USER jenkins
