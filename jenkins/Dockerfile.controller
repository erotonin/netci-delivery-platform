ARG JENKINS_CONTROLLER_IMAGE=jenkins/jenkins:2.555.3-lts-jdk21@sha256:e82bbdcffb6361c081ac66bbdcd5802a299b3631c78c3be04a0a91c7f952fff3
FROM ${JENKINS_CONTROLLER_IMAGE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git jq \
    && rm -rf /var/lib/apt/lists/*
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
# The image carries exactly the declared set (ADR-059) or is not built: a dependency the
# resolver pulled in or upgraded would otherwise surface only as drift after the rollout.
# Read from each plugin's own manifest, not from jenkins-plugin-cli's report (which goes to
# stderr in a format of its own).
RUN for f in /usr/share/jenkins/ref/plugins/*.jpi; do \
      printf '%s:%s\n' "$(basename "$f" .jpi)" \
        "$(unzip -p "$f" META-INF/MANIFEST.MF | tr -d '\r' | sed -n 's/^Plugin-Version: //p')"; \
    done | sort > /tmp/installed \
    && grep -v '^#' /usr/share/jenkins/ref/plugins.txt | sort > /tmp/declared \
    && diff -u /tmp/declared /tmp/installed \
    && rm /tmp/installed /tmp/declared

# netCI's own plugin (ADR-063), built from this repository at the same commit (make plugin);
# outside the check above, which is about the plugins Jenkins publishes. ".override": the image's
# start script copies a plugin over an existing JENKINS_HOME only when its version is newer, and
# this plugin belongs to the image, whatever its version says.
COPY plugin/target/netci.hpi /usr/share/jenkins/ref/plugins/netci.jpi.override

USER jenkins
