ARG JENKINS_CONTROLLER_IMAGE=jenkins/jenkins:2.555.3-lts-jdk21@sha256:e82bbdcffb6361c081ac66bbdcd5802a299b3631c78c3be04a0a91c7f952fff3
FROM ${JENKINS_CONTROLLER_IMAGE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git jq \
    && rm -rf /var/lib/apt/lists/*
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
# The image carries exactly the declared set (ADR-059) or is not built: a dependency the
# resolver pulled in or upgraded would otherwise surface only as drift after the rollout.
# Read from each plugin's own manifest, not from jenkins-plugin-cli's report (which goes to
# stderr in a format of its own).
RUN for f in /usr/share/jenkins/ref/plugins/*.jpi; do \
      printf '%s:%s\n' "$(basename "$f" .jpi)" \
        "$(unzip -p "$f" META-INF/MANIFEST.MF | tr -d '\r' | sed -n 's/^Plugin-Version: //p')"; \
    done | sort > /tmp/installed \
    && grep -v '^#' /usr/share/jenkins/ref/plugins.txt | sort > /tmp/declared \
    && diff -u /tmp/declared /tmp/installed \
    && rm /tmp/installed /tmp/declared

# netCI's own plugin (ADR-063), built from this repository at the same commit (make plugin);
# outside the check above, which is about the plugins Jenkins publishes. ".override": the image's
# start script copies a plugin over an existing JENKINS_HOME only when its version is newer, and
# this plugin belongs to the image, whatever its version says.
COPY plugin/target/netci.hpi /usr/share/jenkins/ref/plugins/netci.jpi.override

# The plugins unzipped into the image, so that a controller does not unzip every one of them at
# every start -- about 1.2 s of each start, takeovers included. The cell agent links the pod's plugin
# root to /usr/share/jenkins/pluginroot when it exists (cellagent.LinkPluginRoot). Jenkins skips a plugin whose archive has the time it recorded
# when it unzipped it (.timestamp2), and the cell agent gives the archives in JENKINS_HOME the
# image's times (cellagent.AlignPluginTimes). Jenkins itself unzips them here, from copies that
# keep the image's times, so the result is exactly what it would make at a start; a plugin that
# differs is unzipped at start as before.
RUN set -eu; h="$(mktemp -d)"; mkdir -p "$h/plugins" /usr/share/jenkins/pluginroot; \
    for f in /usr/share/jenkins/ref/plugins/*; do cp -p "$f" "$h/plugins/$(basename "${f%.override}")"; done; \
    JENKINS_HOME="$h" java -Djenkins.install.runSetupWizard=false -jar /usr/share/jenkins/jenkins.war \
      --httpPort=18080 --httpListenAddress=127.0.0.1 --webroot="$h/war" --pluginroot=/usr/share/jenkins/pluginroot \
      >"$h/log" 2>&1 & pid=$!; \
    for i in $(seq 1 300); do grep -q "fully up and running" "$h/log" && break; kill -0 "$pid" || break; sleep 1; done; \
    grep -q "fully up and running" "$h/log" || { tail -40 "$h/log"; exit 1; }; \
    kill "$pid"; wait "$pid" || true; rm -rf "$h"; \
    chown -R jenkins:jenkins /usr/share/jenkins/pluginroot

USER jenkins
