ARG JENKINS_CONTROLLER_IMAGE=jenkins/jenkins:2.541.1-lts-jdk21
FROM ${JENKINS_CONTROLLER_IMAGE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git jq \
    && rm -rf /var/lib/apt/lists/*
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# The Jenkins library retriever requires a real SCM repository. Snapshot the
# checked-in library into the controller image so JCasC can fetch branch main
# without any UI setup or mutable controller-home state.
COPY --chown=jenkins:jenkins shared-library/ /opt/netci-shared-library/
RUN git -C /opt/netci-shared-library init --initial-branch=main \
    && git -C /opt/netci-shared-library add . \
    && git -C /opt/netci-shared-library \
       -c user.name='netCI build' -c user.email='netci@localhost' \
       commit -m 'Snapshot netCI shared library'
USER jenkins
